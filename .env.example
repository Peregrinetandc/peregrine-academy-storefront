# ==============================================================================
# Peregrine Academy Storefront Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRET VALUES TO VERSION CONTROL

# Storefront Public URL
NEXT_PUBLIC_STOREFRONT_URL=https://www.peregrineacademy.in

# Razorpay Payment Gateway (Test or Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Meta Ads Tracking
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# Cross-Service Provisioning Secrets
# Shared secret for HMAC-SHA256 tokens between storefront and arabic.peregrineacademy.in
BUNDLE_HANDOFF_SECRET=your_32_byte_cryptographic_secret_here

# LMS Service API (learn.peregrineacademy.in)
LMS_API_URL=https://learn.peregrineacademy.in
LMS_SERVICE_ROLE_KEY=your_lms_service_role_or_api_key_here

# Reader Service API (arabic.peregrineacademy.in)
READER_API_URL=https://arabic.peregrineacademy.in

# Storefront Central Supabase Ledger (Optional - can run standalone with SQLite/Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-storefront-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_storefront_supabase_service_role_key_here

# Support & Notifications
SUPPORT_EMAIL=hello@peregrinehub.com
ADMIN_NOTIFICATION_EMAIL=admin@peregrineacademy.in
